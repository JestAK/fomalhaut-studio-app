# Keep the real .env on your VPS. Do not commit it or send it to the browser.
BOT_TOKEN=replace_with_botfather_token
TEAM_CHAT_ID=-1001234567890
ADMIN_IDS=111111111
TELEGRAM_API_ID=replace_with_api_id
TELEGRAM_API_HASH=replace_with_api_hash
APP_DOMAIN=studio.example.com
APP_URL=https://studio.example.com
# Keep the same Compose project name across releases. For existing deployments use the original value.
COMPOSE_PROJECT_NAME=fomalhaut-studio

# info: requests + jobs; warn: warnings/errors; error: errors only
LOG_LEVEL=info

# Optional browser login: Client ID from BotFather > Login Widget (not TELEGRAM_API_ID)
TELEGRAM_LOGIN_CLIENT_ID=

# Notion: internal integration, Read content only; share the corrections database with it.
NOTION_TOKEN=
NOTION_DATABASE_ID=
